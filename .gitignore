# Data and generated outputs
data/raw/*
!data/raw/.gitkeep
!data/raw/inbox/
!data/raw/archive/
!data/raw/quarantine/
data/raw/inbox/*
!data/raw/inbox/.gitkeep
data/raw/archive/*
!data/raw/archive/.gitkeep
data/raw/quarantine/*
!data/raw/quarantine/.gitkeep

data/processed/*
!data/processed/.gitkeep

reports/quality/*
!reports/quality/.gitkeep

reports/ops/*
!reports/ops/.gitkeep

# Power BI binaries
*.pbix
*.pbit

# Re-include versioned PBIP and local config JSONs even when a global gitignore blocks *.json
!powerbi/**/*.json
!powerbi/**/.pbixproj.json
!powerbi/**/*.pbir
!powerbi/**/*.pbidataset
!powerbi/**/*.tmdl
!powerbi/**/*.pbism
!powerbi/**/.platform
!config/**/*.json
!apps/**/*.json
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/*.abf

# Local toolchains and environments
tools/
.venv/
node_modules/
dist/
test-results/
playwright-report/
.pytest_cache/
.virtual_documents/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local-only metadata
.env
.env.*
.vscode/
.idea/
.codex
.worktrees/
