{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "cross-mismatch-bars",
  "position": {
    "x": 42,
    "y": 315,
    "z": 800,
    "height": 335,
    "width": 725,
    "tabOrder": 800
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "active": true,
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Leads"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "Leads.Country"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Leads"
                    }
                  },
                  "Property": "Cross-Border Share"
                }
              },
              "queryRef": "Leads.Cross-Border Share"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Leads"
                  }
                },
                "Property": "Cross-Border Share"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "title": [
        {
          "properties": {
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'Distributed-operation signal by market'"
                }
              }
            },
            "fontFamily": {
              "expr": {
                "Literal": {
                  "Value": "'Aptos Display'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": "#183A59"
              }
            },
            "alignment": {
              "expr": {
                "Literal": {
                  "Value": "'left'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
